+    // Bounded wait: returns false on timeout so the suspender can resend the
+    // signal instead of waiting forever for a wake-up that never comes.
+    bool waitFor(double relativeSeconds)
+    {
+        struct timespec deadline;
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        time_t wholeSeconds = static_cast<time_t>(relativeSeconds);
+        deadline.tv_sec += wholeSeconds;
+        deadline.tv_nsec += static_cast<long>((relativeSeconds - wholeSeconds) * 1e9);
+        if (deadline.tv_nsec >= 1000000000L) {
+            deadline.tv_sec += 1;
+            deadline.tv_nsec -= 1000000000L;
+        }
+        int rc;
+        while ((rc = sem_timedwait(&m_platformSemaphore, &deadline)) == -1 && errno == EINTR) { }
+        return rc == 0;
+    }
+#endif
